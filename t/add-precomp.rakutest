#!/usr/bin/env raku

use Test;

# What a stage precompiled is what gets loaded: after an add, and after another add into the same repo (which
# changes the repo's id), loading every unit recompiles nothing. Dists stage side by side and precompile in
# children of their own; Rakudo then checks each dependency by its checksum, and must find them all current.
# A child pakku with HOME in a temporary directory: the 'home' repo is a named repo of the chain, as for a user.
my $root = $*PROGRAM.parent.parent.absolute.IO;
my $tmp  = $*TMPDIR.add( 'pakku-add-precomp-test-' ~ $*PID );
my $repo = $tmp.add( '.raku' );

$tmp.add( '.pakku' ).mkdir;

END { run 'rm', '-rf', $tmp if $tmp.e }

$tmp.add( '.pakku' ).add( 'config.json' ).spurt: Rakudo::Internals::JSON.to-json: %(
  pakku  => %( cache => False, pretty => False, bar => False, spinner => False, verbose => ( %*ENV<PAKKU_TEST_VERBOSE> // 'nothing' ) ),
  recman => [ %( name => 'fixture', location => ~$root.add( 'fixtures' ).add( 'dists' ), priority => 1, active => True ), ],
);

my %env = %*ENV, HOME => ~$tmp;

%env<RAKULIB>:delete;

my sub pakku ( *@arg ) { run( $*EXECUTABLE, '-I', $root, $root.add( 'bin' ).add( 'pakku' ), |@arg, :%env ).exitcode }

# the precompiled files of the repo, by content (Windows reads modification times as 1969)
my sub precomp ( ) {
  Rakudo::Internals.DIR-RECURSE( ~$repo.add( 'precomp' ) ).grep( { not .IO.extension } ).map( { $_ => .IO.slurp( :bin ) } ).Hash
}

# load every unit the repo provides, each in a process of its own
my sub load ( ) {
  my @unit = $repo.add( 'dist' ).dir.map( { Rakudo::Internals::JSON.from-json( .slurp )<provides>.keys.Slip } ).sort;
  @unit.grep( -> $unit { run( $*EXECUTABLE, '-e', "need $unit", :%env, :out, :err ).exitcode } ).List;
}

my sub recompiled ( %before ) { precomp( ).grep( { not ( %before{ .key }:exists and %before{ .key } eqv .value ) } ).map( *.key ).List }

is pakku( 'add', 'to', 'home', 'Fixture::Bar' ), 0, 'add Fixture::Bar, with Fixture::Foo and Fixture::Qux beside each other';

my %first = precomp;

ok %first >= 4, 'every unit was precompiled in the stage' or diag "precomp: { %first.keys.sort }";

is-deeply load, ( ), 'every unit loads';
is-deeply recompiled( %first ), ( ), 'and loading recompiled nothing';

is pakku( 'add', 'to', 'home', 'Fixture::Baz' ), 0, 'add Fixture::Baz into the same repo: its id changes';

my %second = precomp;

is-deeply load, ( ), 'every unit loads after the second add';
is-deeply recompiled( %second ), ( ), 'and loading recompiled nothing, neither the new dist nor the ones before it';

done-testing;
