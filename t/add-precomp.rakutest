#!/usr/bin/env raku

use Test;

# What gets precompiled at an add is what gets loaded: after an add, and after another add into the same repo
# (which changes the repo's id), loading every unit recompiles nothing. Dists precompile side by side in
# children of their own; Rakudo then checks each dependency by its checksum and its source, and must find
# them all current. Into home, a repo every process names, and into a path, which no process names.
# A child pakku with HOME in a temporary directory: 'home' is a named repo of the chain, as for a user.
my $root = $*PROGRAM.parent.parent.absolute.IO;
my $tmp  = $*TMPDIR.add( 'pakku-add-precomp-test-' ~ $*PID );

$tmp.add( '.pakku' ).mkdir;

END { run 'rm', '-rf', $tmp if $tmp.e }

$tmp.add( '.pakku' ).add( 'config.json' ).spurt: Rakudo::Internals::JSON.to-json: %(
  pakku  => %( cache => False, pretty => False, bar => False, spinner => False, verbose => ( %*ENV<PAKKU_TEST_VERBOSE> // 'nothing' ) ),
  recman => [ %( name => 'fixture', location => ~$root.add( 'fixtures' ).add( 'dists' ), priority => 1, active => True ), ],
);

my %env = %*ENV, HOME => ~$tmp;

%env<RAKULIB>:delete;

# exit code and what it said at info level
my sub pakku ( *@arg ) {
  my $proc = run $*EXECUTABLE, '-I', $root, $root.add( 'bin' ).add( 'pakku' ), 'nopretty', 'verbose', 'info', |@arg, :%env, :out, :err;
  my $out  = $proc.out.slurp( :close );
  diag $out ~ $proc.err.slurp( :close ) if %*ENV<PAKKU_TEST_VERBOSE>;
  $proc.exitcode, $out;
}

# the precompiled files of a repo, by content (Windows reads modification times as 1969)
my sub precomp ( IO::Path:D $repo ) {
  Rakudo::Internals.DIR-RECURSE( ~$repo.add( 'precomp' ) ).grep( { not .IO.extension } ).map( { $_ => .IO.slurp( :bin ) } ).Hash
}

# load every unit a repo provides, each in a process of its own; @lib says how that process finds the repo
my sub load ( IO::Path:D $repo, *@lib ) {
  my @unit = $repo.add( 'dist' ).dir.map( { Rakudo::Internals::JSON.from-json( .slurp )<provides>.keys.Slip } ).sort;
  @unit.grep( -> $unit { run( $*EXECUTABLE, |@lib, '-e', "need $unit", :%env, :out, :err ).exitcode } ).List;
}

my sub recompiled ( IO::Path:D $repo, %before ) { precomp( $repo ).grep( { not ( %before{ .key }:exists and %before{ .key } eqv .value ) } ).map( *.key ).List }

# the path first: each add gets the whole tree (an add to home would satisfy the path's dependencies from home)
# a path gets its dists installed in it at deploy (ADD: ｢dist｣), a repo every process names the stage moved in
for ( ~$tmp.add( 'custom' ), $tmp.add( 'custom' ), ( "-Iinst#{ $tmp.add( 'custom' ) }", ), True ), ( 'home', $tmp.add( '.raku' ), (), False ) -> ( $to, $repo, @lib, $in-place ) {

  subtest "add to $to", {

    my ( $exitcode, $out ) = pakku 'add', 'to', $to, 'Fixture::Bar';

    is $exitcode, 0, 'add Fixture::Bar, with Fixture::Foo and Fixture::Qux beside each other';

    is so( $out ~~ / 'ADD: ｢Fixture::Foo:' / ), $in-place, $in-place ?? 'installed in the path itself' !! 'the stage moved in, not installed and precompiled again';

    my %first = precomp $repo;

    ok %first >= 4, 'every unit was precompiled' or diag "precomp: { %first.keys.sort }";

    is-deeply load( $repo, |@lib ), ( ), 'every unit loads';
    is-deeply recompiled( $repo, %first ), ( ), 'and loading recompiled nothing';

    is pakku( 'add', 'to', $to, 'Fixture::Baz' ).head, 0, 'add Fixture::Baz into the same repo: its id changes';

    my @foo = $repo.add( 'dist' ).dir.grep( { Rakudo::Internals::JSON.from-json( .slurp )<name> eq 'Fixture::Foo' } );

    is +@foo, 1, 'Fixture::Baz takes the Fixture::Foo that is there: a second one would be the one Fixture::Bar loads';

    my %second = precomp $repo;

    is-deeply load( $repo, |@lib ), ( ), 'every unit loads after the second add';
    is-deeply recompiled( $repo, %second ), ( ), 'and loading recompiled nothing, neither the new dist nor the ones before it';

  }

}

done-testing;
