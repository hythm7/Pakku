#!/usr/bin/env raku

use Test;

use Pakku;

# End-to-end: add Fixture::Bar (and its dependencies) from the offline fixture recman into a temporary repo.
my $fixtures = $*PROGRAM.parent.parent.add('fixtures').add('dists').absolute;
my $tmp      = $*TMPDIR.add( 'pakku-add-test-' ~ $*PID );
my $home     = $tmp.add('home');
my $repo     = $tmp.add('repo');

$home.mkdir;

END { run 'rm', '-rf', $tmp if $tmp.e }

my %cnf =
  pakku  => %( home => $home, cache => False, verbose => ( %*ENV<PAKKU_TEST_VERBOSE> // 'nothing' ), pretty => False, bar => False, spinner => False, async => False ),
  recman => [ %( name => 'fixture', location => $fixtures, priority => 1, active => True ), ];

my $pakku;

lives-ok { $pakku = Pakku.new: :%cnf }, 'Create Pakku with the fixture recman';

lives-ok { $pakku.fly: 'refresh' },                        'refresh with no recman names dispatches';
lives-ok { $pakku.fly: 'refresh', recman => [ 'fixture' ] }, 'refresh with a recman name dispatches';

lives-ok { $pakku.fly: 'add', spec => [ 'Fixture::Bar' ], to => ~$repo }, 'add Fixture::Bar to a temporary repo';

my $inst = CompUnit::Repository::Installation.new: prefix => $repo;

ok $inst.candidates( 'Fixture::Bar' ),                 'Fixture::Bar is installed';
ok $inst.candidates( 'Fixture::Foo', ver => '0.2+' ),  'Fixture::Foo:ver<0.2+> dependency is installed';
is $inst.candidates( 'Fixture::Foo' ).elems, 1,        'Bar wants Foo:ver<0.2+>, Qux a bare Foo: one Foo is installed (B17)';
ok $inst.candidates( 'Fixture::Qux' ) || $inst.candidates( 'Fixture::Baz' ), 'one alternative of the any-group is installed';
ok ( $repo.add( 'bin' ).d and $repo.add( 'bin' ).dir.first( *.basename eq 'bar' | 'bar.bat' | 'bar.exe' ) ),                  'bin wrapper for bar was deployed'
  or diag "bin: { $repo.add( 'bin' ).d ?? $repo.add( 'bin' ).dir.map( *.basename ).sort !! 'no such directory' }, repo: { $repo.dir.map( *.basename ).sort }";

my $meta = $inst.candidates( 'Fixture::Bar' ).head.meta;
is $meta<ver>, '1.0', 'installed Fixture::Bar has the expected version';

# cleaning an older release: ver<1.2> is a prefix of 1.2.1, the exact remove takes the one dist it was given
for '1.2', '1.2.1' -> $ver {

  my $dir = $tmp.add( "solo-$ver" );

  $dir.add( 'lib' ).add( 'Fixture' ).mkdir;
  $dir.add( 'lib' ).add( 'Fixture' ).add( 'Solo.rakumod' ).spurt: "unit module Fixture::Solo;\n";
  $dir.add( 'META6.json' ).spurt: Rakudo::Internals::JSON.to-json: %( name => 'Fixture::Solo', version => $ver, auth => 'zef:fixture', provides => %( 'Fixture::Solo' => 'lib/Fixture/Solo.rakumod' ) );

  lives-ok { $pakku.fly: 'add', path => $dir, to => ~$repo, :!test }, "add Fixture::Solo $ver from a path";

}

my @solo = $inst.candidates( 'Fixture::Solo' ).map( *.Str ).sort;

is +@solo, 2, 'both releases of Fixture::Solo are installed';

lives-ok { $pakku.fly: 'remove', spec => [ @solo.first( *.contains: 'ver<1.2>' ) ], from => ~$repo, :exact }, 'exact remove of the older release';

is-deeply $inst.candidates( 'Fixture::Solo' ).map( *.meta<ver>.Str ).List, ( '1.2.1', ), 'the newer release, whose version starts the same, is still there';

# a dist with a builder: the META reaches the builder whole, nested hashes and all, as MakeFromJSON reads them
# (the ' in the directory name: paths go into the builder's code, and must stay strings there)
my $built = $tmp.add( "it's built" );

$built.add( 'lib' ).add( 'Fixture' ).add( 'Built' ).mkdir;
$built.add( 'lib' ).add( 'Fixture' ).add( 'Built.rakumod' ).spurt: "unit module Fixture::Built;\n";
$built.add( 'lib' ).add( 'Fixture' ).add( 'Built' ).add( 'Builder.rakumod' ).spurt: q:to/BUILDER/;
  unit class Fixture::Built::Builder;
  has %.meta;
  method build ( $dir ) { $dir.IO.add( 'built' ).spurt: %!meta<build><makefile-variables><run>.join: ' ' }
  BUILDER
$built.add( 'META6.json' ).spurt: Rakudo::Internals::JSON.to-json: %(
  name     => 'Fixture::Built',
  version  => '1',
  auth     => 'zef:fixture',
  builder  => 'Fixture::Built::Builder',
  build    => %( makefile-variables => %( run => [ 'raku', 'configure.raku' ] ) ),
  provides => %( 'Fixture::Built' => 'lib/Fixture/Built.rakumod', 'Fixture::Built::Builder' => 'lib/Fixture/Built/Builder.rakumod' ),
);

lives-ok { $pakku.fly: 'add', path => $built, to => ~$repo, :!test }, 'add a dist that has a builder';

is ( $built.add( 'built' ).e ?? $built.add( 'built' ).slurp !! Nil ), 'raku configure.raku', 'the builder ran and read the META it was given';
ok $inst.candidates( 'Fixture::Built' ), 'the dist with a builder is installed';

# a dist with a Build.rakumod, from a directory whose name has a ' too
my $build = $tmp.add( "it's a Build" );

$build.add( 'lib' ).mkdir;
$build.add( 'lib' ).add( 'Fixture-Build.rakumod' ).spurt: "unit module Fixture::Build;\n";
$build.add( 'Build.rakumod' ).spurt: q:to/BUILD/;
  class Build { method build ( $dir ) { $dir.IO.add( 'built' ).spurt: $dir } }
  BUILD
$build.add( 'META6.json' ).spurt: Rakudo::Internals::JSON.to-json: %( name => 'Fixture::Build', version => '1', auth => 'zef:fixture', provides => %( 'Fixture::Build' => 'lib/Fixture-Build.rakumod' ) );

lives-ok { $pakku.fly: 'add', path => $build, to => ~$repo, :!test }, 'add a dist that has a Build.rakumod';

is ( $build.add( 'built' ).e ?? $build.add( 'built' ).slurp !! Nil ), ~$build, 'Build.rakumod ran, and was given its directory';

done-testing;
