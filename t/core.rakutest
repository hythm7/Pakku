#!/usr/bin/env raku

use Test;

use Pakku::Core;

# A Core wired to the offline fixture ecosystem under t/fixtures (no network, see GitHub issue #40).
my $fixtures = $*PROGRAM.parent.add('fixtures').add('dists').absolute;

my $core;

lives-ok {
  $core =
  class {
    also does Pakku::Core;

    submethod BUILD( :%!cnf ) {

      my @recman = ( %( :name<fixture>, :location($fixtures), :1priority, :active ), );

      $!log    = Pakku::Log.new: :verbose<nothing>;

      $!recman = Pakku::Recman.new: :@recman;

      @!repo = $*REPO.repo-chain.grep( CompUnit::Repository::Installation );

    }
  } .new
}, 'Compose Pakku::Core';

ok  $core.satisfied( spec => Pakku::Spec.new( { any => [ "archive:ver<13>:from<native>", "archive:from<native>", "archiveint:from<native>" ] } ) ), 'Native dependency exists';
nok $core.satisfied( spec => Pakku::Spec.new( { :from<native>, :name<missing> } ) ), 'Native dependency missing';

ok  $core.satisfied( spec => Pakku::Spec.new( { :from<bin>, :name<raku>    } ) ), 'Binary dependency exists';
nok $core.satisfied( spec => Pakku::Spec.new( { :from<bin>, :name<missing> } ) ), 'Binary dependency missing';

ok  $core.satisfied( spec => Pakku::Spec.new( 'rakudo'          ) ), 'Raku dependency exists';
nok $core.satisfied( spec => Pakku::Spec.new( 'rakudo:ver<-42>' ) ), 'Raku dependency missing';

dies-ok  { $core.satisfy( spec => Pakku::Spec.new( { :from<native>, :name<archive> } ) ) }, 'Native dependency no satisfy';
dies-ok  { $core.satisfy( spec => Pakku::Spec.new( { :from<bin>,    :name<raku>    } ) ) }, 'Binary dependency no satisfy';

my $meta;
lives-ok { $meta = $core.satisfy( spec => Pakku::Spec.new( { any => <Fixture::Nope Fixture::Foo Fixture::Baz> } ) ) }, 'Can satisfy a dependency from the fixture recman';
is $meta.name, 'Fixture::Foo', 'first available alternative wins';

dies-ok { $core.satisfy( spec => Pakku::Spec.new( 'foobarbaz:from<Native>' ) ) }, 'can not satisfy native dependency';
dies-ok { $core.satisfy( spec => Pakku::Spec.new( 'Fixture::Nope' ) ) }, 'can not satisfy unknown dependency';

my @deps = $core.get-deps( $core.satisfy( spec => Pakku::Spec.new( 'Fixture::Bar' ) ) ).flat;
ok @deps.map( *.name ).grep( 'Fixture::Foo' ), 'get-deps resolves Fixture::Bar -> Fixture::Foo';
ok @deps.map( *.name ).first( 'Fixture::Qux' | 'Fixture::Baz' ), 'get-deps resolves one alternative of the any-group';

# S22: a group inside the alternatives is taken whole, and only when all of it can be met
my @group = $core.get-deps( Pakku::Meta.new( %( name => 'Dev::Group', version => '1', depends => [ { any => [ 'Fixture::Nope', [ 'Fixture::Foo', 'Fixture::Baz' ] ] } ] ) ) );
ok @group.map( *.name ).grep( 'Fixture::Foo' ) && @group.map( *.name ).grep( 'Fixture::Baz' ), 'a group inside any resolves every member';
my @first = $core.get-deps( Pakku::Meta.new( %( name => 'Dev::First', version => '1', depends => [ { any => [ [ 'Fixture::Foo', 'Fixture::Nope' ], 'Fixture::Baz' ] } ] ) ) );
ok @first.map( *.name ).grep( 'Fixture::Baz' ) && not @first.map( *.name ).grep( 'Fixture::Foo:ver<0.3>' ), 'a group with a member nobody has is passed over for the next alternative';

done-testing;
